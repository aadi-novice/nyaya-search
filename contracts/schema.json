        "outcome": {
          "title": "Outcome",
          "type": "string"
        },
        "pages": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Pages"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "petitioner": {
          "title": "Petitioner",
          "type": "string"
