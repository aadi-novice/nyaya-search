    "SearchResponse": {
      "additionalProperties": false,
      "description": "POST /search: the ranked passages /ask would answer from, with no LLM call.\n\nstatus: `passages` (top score at or above the refusal threshold, or a\ncitation lookup); `refused` (no candidates, or the top score is below the\nthreshold: the passages are then the nearest ones); `no_match_with_filters`;\n`error`.",
      "properties": {
        "filters_applied": {
          "additionalProperties": true,
          "title": "Filters Applied",
          "type": "object"
        },
        "notices": {
          "items": {
            "type": "string"
          },
          "title": "Notices",
          "type": "array"
        },
        "passages": {
