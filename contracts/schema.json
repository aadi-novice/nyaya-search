            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Position Map"
        },
        "respondent": {
          "title": "Respondent",
          "type": "string"
        },
        "scr_citation": {
          "title": "Scr Citation",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        }
