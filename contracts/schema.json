        },
        "status": {
          "$ref": "#/$defs/Status"
        },
        "threshold": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Threshold"
        },
        "timings_ms": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Timings Ms",
          "type": "object"
        },
        "top_score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Top Score"
        },
        "versions": {
          "$ref": "#/$defs/Versions"
        }
      },
      "required": [
        "request_id",
        "status",
        "notices",
        "route",
        "filters_applied",
        "versions",
        "timings_ms"
      ],
      "title": "SearchResponse",
      "type": "object"
