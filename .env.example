# Copy to .env and fill in. .env is never committed.
DATABASE_URL=postgresql://nyaya:nyaya@127.0.0.1:5432/nyaya

# Answer LLM: Gemini Flash through Google's OpenAI-compatible endpoint.
# Free tier: prompts may be used to improve Google products.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.8-flash
LLM_API_KEY=            # your Gemini (Google AI Studio) key

# Judge LLM (must be a different model family): gpt-oss-120b on Groq.
JUDGE_BASE_URL=https://api.groq.com/openai/v1
JUDGE_MODEL=openai/gpt-oss-120b
JUDGE_API_KEY=          # your Groq key

# Provider keys
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=     # fallback reranker (Cohere Rerank 5 Fast, paid per call)
HF_TOKEN=               # model downloads from Hugging Face
KAGGLE_USERNAME=
KAGGLE_KEY=
# Optional free-tier providers: NVIDIA_API_KEY, MISTRAL_API_KEY,
# CLOUDFLARE_ACCOUNT_ID, CLOUDFLARE_API_TOKEN, GITHUB_TOKEN, COHERE_API_KEY
HF_HOME=
